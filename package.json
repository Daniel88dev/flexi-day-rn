{
  "name": "flexi-day-rn",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "ios:device": "node scripts/ios-device.js",
    "prebuild": "expo prebuild --platform ios",
    "release:ios": "eas build --platform ios --profile production --auto-submit",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "store:ddl": "node scripts/generate-store-ddl.mjs",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@better-auth/expo": "^1.7.18",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@tailwindcss/postcss": "4.1.12",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.23",
