    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "eas-cli": "^27.5.0",
    "eslint": "^10.14.0",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.css$": "<rootDir>/jest/css-stub.js",
      "^expo-notifications$": "<rootDir>/jest/expo-notifications.js",
      "^@react-native-google-signin/google-signin$": "<rootDir>/jest/google-signin.js",
      "^expo-sqlite/kv-store$": "<rootDir>/jest/kv-store.js"
    },
    "setupFiles": [
      "<rootDir>/jest/modal-dismiss.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest/warm-up.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  }
