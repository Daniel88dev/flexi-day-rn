{
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "Bash(pnpm run *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm expo *)"
    ],
    "deny": [
      "NotebookEdit",
      "CronCreate",
      "CronDelete",
      "CronList",
      "PushNotification",
      "ReportFindings",
      "ScheduleWakeup"
    ]
  },
  "skillListingMaxDescChars": 250,
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableBundledSkills": true,
  "disableArtifact": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; pnpm exec prettier --write --ignore-unknown \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting with prettier...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
