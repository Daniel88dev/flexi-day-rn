# Copy to .env when the backend is not on the machine running Metro. Without this file the app
# targets the Metro host on port 8080, which covers the simulator and a phone on the same LAN.
EXPO_PUBLIC_API_URL=http://192.168.0.33:8080

# Web app the phone links out to for sign-up and forgot-password. Defaults to production.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
