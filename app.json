{
  "expo": {
    "name": "Flexi Day",
    "slug": "flexi-day",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "flexiday",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.flexiday.app",
      "supportsTablet": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
