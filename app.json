{
  "expo": {
    "name": "Flexi Day",
    "slug": "flexi-day",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "flexiday",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.flexiday.app",
      "supportsTablet": false,
      "appleTeamId": "7DD5F92WWS"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
